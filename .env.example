# ==============================================================================
# SUARE SOCIALS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Instagram Graph API (Meta for Developers)
# Get from: https://developers.facebook.com -> Tools -> Graph API Explorer
INSTAGRAM_ACCESS_TOKEN=your_meta_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# 2. Threads API (Meta Graph API for Threads)
# Get from: https://developers.facebook.com -> Threads Use Case
THREADS_ACCESS_TOKEN=your_meta_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here

# 3. TikTok Content Posting API
# Get from: https://developers.tiktok.com
TIKTOK_ACCESS_TOKEN=your_tiktok_open_api_token_here

# 4. YouTube Data API v3 (Google Cloud Console)
# Get from: https://console.cloud.google.com -> Credentials -> OAuth 2.0
YOUTUBE_ACCESS_TOKEN=your_google_youtube_access_token_here
YOUTUBE_SAMPLE_VIDEO_ID=your_video_id_to_attach_thumbnail

# 5. Local n8n Instance Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/suare-social-post

# 6. Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
